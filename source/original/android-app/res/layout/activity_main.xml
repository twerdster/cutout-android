<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:opencv="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity" >

    <LinearLayout
        android:id="@+id/welcome_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" >

        <ImageView
            android:id="@+id/welcome_android"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_margin="50dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/action_load"
            android:textColor="@color/material_500_gray"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="horizontal" >

            <ImageButton
                android:id="@+id/action_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginRight="30dp"
                android:background="@color/transparent"
                android:onClick="onActionClick"
                android:src="@drawable/home_camera"
                android:textColor="@color/border_holo_dark" />

            <ImageButton
                android:id="@+id/action_gallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:layout_marginLeft="30dp"
                android:background="@color/transparent"
                android:onClick="onActionClick"
                android:src="@drawable/home_gallery"
                android:textColor="@color/border_holo_dark" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/work_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:visibility="visible" >

        <RelativeLayout
            android:id="@+id/move_view_layout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" >

            <ImageView
                android:id="@+id/move_view_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent"
                android:scaleType="fitXY" />

            <FrameLayout
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.eladrich.scribbler.PhotoDragView
                android:id="@+id/image_view_move"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </RelativeLayout>

        <FrameLayout
            android:id="@+id/scribble_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" >

            <!--
             android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
            -->

            <com.eladrich.scribbler.ZoomView
                android:id="@+id/scribble_zoom_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" >

                    <ImageView
                        android:id="@+id/image_view_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:scaleType="centerInside" />

                    <com.eladrich.scribbler.DrawableImageView
                        android:id="@+id/image_view_draw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:scaleType="centerInside" />
                </RelativeLayout>
            </com.eladrich.scribbler.ZoomView>
            <!--
       <com.eladrich.scribbler.ScribbleView
            android:id="@+id/scribble_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
            -->

        </FrameLayout>

        <ViewAnimator
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom|center_horizontal" >

            <RelativeLayout
                android:id="@+id/details_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@color/design_gray"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="visible" >

                <TextView
                    android:id="@+id/details_seperator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/material_500_gray" />

                <!--
                 <ImageButton
                android:id="@+id/scribble_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:layout_marginTop="-30dp"
                android:background="@drawable/zoom_off_button"
                android:clickable="false"
                android:clipChildren="false"
                android:visibility="visible" />

            <ImageButton
                android:id="@+id/fake_scribble_button"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginRight="15dp"
                android:layout_marginTop="-30dp"
                android:layout_toLeftOf="@id/scribble_zoom"
                android:background="@drawable/ic_foreground_scribble"
                android:clickable="false"
                android:clipChildren="false"
                android:visibility="gone" />
                -->

                <LinearLayout
                    android:id="@+id/instrcutions_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/details_seperator"
                    android:layout_marginRight="145dp"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/scibble_message"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/action_load"
                        android:textColor="@color/material_500_gray"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!--
                     <ImageButton
                    android:id="@+id/ok_button"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/button"
                    android:clickable="false"
                    android:padding="10dp"
                    android:src="@drawable/ic_v"
                    android:visibility="gone" />
                    -->
                </LinearLayout>

                <!--
            <TextView
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/border_holo_dark"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/touched_xy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/inverted_xy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/touched_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/touched_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
                -->
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/effects_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@color/design_gray"
                android:orientation="vertical"
                android:visibility="visible" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/material_500_gray" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:paddingTop="10dp" >

                        <Button
                            android:id="@+id/effect_stick_camera"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_button_sticker"
                            android:onClick="onEffectClick"
                            android:text="@string/effect_stick_camera_string"
                            android:textColor="@color/design_white" />

                        <Button
                            android:id="@+id/effect_blur"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_button_blur"
                            android:onClick="onEffectClick"
                            android:text="@string/effect_blur_string"
                            android:textColor="@color/design_white" />

                        <Button
                            android:id="@+id/effect_gray"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_button_sticker"
                            android:onClick="onEffectClick"
                            android:text="@string/effect_gray_string"
                            android:textColor="@color/design_white" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/camera_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@color/design_gray"
                android:orientation="vertical"
                android:visibility="visible" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/material_500_gray" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >

                    <ImageButton
                        android:id="@+id/camera_capture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button"
                        android:onClick="onEffectClick"
                        android:src="@drawable/ic_camera_capture"
                        android:textColor="@color/border_holo_dark" />

                    <ImageButton
                        android:id="@+id/camera_undo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button"
                        android:onClick="onEffectClick"
                        android:src="@drawable/ic_back"
                        android:textColor="@color/border_holo_dark"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blur_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@color/design_gray"
                android:orientation="vertical"
                android:visibility="visible" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/material_500_gray" />

                <TextView
                    android:id="@+id/blur_seek_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/action_seek_blur"
                    android:textColor="@color/material_500_gray"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/blur_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="40"
                    android:progress="20" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gray_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@color/design_gray"
                android:orientation="vertical"
                android:visibility="visible" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/material_500_gray" />

                <TextView
                    android:id="@+id/gray_seek_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/action_seek_gray"
                    android:textColor="@color/material_500_gray"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/gray_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="40"
                    android:progress="20" />
            </LinearLayout>
        </ViewAnimator>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/floating_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="30dp" >

        <ImageButton
            android:id="@+id/scribble_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/ic_foreground_scribble"
            android:clickable="false"
            android:clipChildren="false"
            android:visibility="visible" />

        <ImageButton
            android:id="@+id/scribble_zoom"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:background="@drawable/zoom_off_button"
            android:clickable="false"
            android:clipChildren="false"
            android:visibility="visible" />
    </LinearLayout>

</FrameLayout>